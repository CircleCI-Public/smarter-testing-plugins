{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "commitMessageTopic": "{{{lookup (split packageFileDir '/') 0}}} dependency {{depName}}",
  "additionalBranchPrefix": "{{{lookup (split packageFileDir '/') 0}}}-",
  "group": {
    "commitMessageTopic": "{{{lookup (split packageFileDir '/') 0}}} {{{groupName}}}"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeSchedule": [
        "* 8-14 * * 1-5"
      ]
    },
    {
      "matchFileNames": ["jest-circleci-coverage/**"],
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react"
    },
    {
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["/(?:^|/)node$/"],
      "groupName": "node"
    },
    {
      "description": "Disable auto-update for jest alias deps - intentionally pinned to a specific major (jest-28, jest-29, etc.) for cross-version testing",
      "matchFileNames": ["jest-circleci-coverage/**"],
      "matchDepNames": ["/^jest(-environment-(jsdom|node))?-\\d+$/"],
      "enabled": false
    }
  ]
}
